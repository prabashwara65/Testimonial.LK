cat > railpack.json <<'EOF'
{
  "$schema": "https://schema.railpack.com",
  "provider": "php",
  "buildAptPackages": [
    "libpng-dev",
    "libjpeg62-turbo-dev",
    "libfreetype6-dev",
    "libwebp-dev"
  ],
  "steps": {
    "build": {
      "commands": [
        "install-php-extensions gd"
      ]
    }
  }
}
EOF